# Public URL of this deployment (no trailing slash). Used for metadata,
# sitemap, and the registry's `homepage`. Defaults to SITE_URL in
# packages/schema/src/constants.ts.
NEXT_PUBLIC_SITE_URL=https://fujin.dev

# Set to "standalone" to build a self-contained server (used by the Dockerfile).
# Leave unset on Vercel.
# NEXT_OUTPUT=standalone
